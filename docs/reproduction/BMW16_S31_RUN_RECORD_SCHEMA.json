{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moe-topk:BMW16_S31_RUN_RECORD_SCHEMA:1.0",
  "title": "BMW16-derived Protocol I run record",
  "description": "One attempt only. PROJECT_DERIVED; not a BB90 implementation or formal V4 result unless separately accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_type",
    "protocol_tag",
    "implementation_label",
    "source_commit",
    "binary_sha256",
    "build_options_sha256",
    "host",
    "network",
    "n",
    "k",
    "dataset_id",
    "input_sha256",
    "oracle_sha256",
    "input_seed_id",
    "share_split_seed_id",
    "algorithm_randomness",
    "session_id",
    "terminal_status",
    "correctness",
    "metrics",
    "metric_provenance",
    "counts",
    "raw_record_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "attempt_type": { "enum": ["warmup", "formal", "diagnostic"] },
    "protocol_tag": {
      "const": "Protocol I + BMW16-derived Select + DCF / PROJECT_DERIVED"
    },
    "implementation_label": { "enum": ["conditional_secure_v1", "conditional_secure_v2"] },
    "source_commit": { "$ref": "#/$defs/sha40" },
    "binary_sha256": { "$ref": "#/$defs/sha256" },
    "build_options_sha256": { "$ref": "#/$defs/sha256" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel", "cpu_model", "vcpu", "ram_bytes", "scratch_bytes", "compiler", "cmake", "openssl"],
      "properties": {
        "os": { "type": "string" },
        "kernel": { "type": "string" },
        "cpu_model": { "type": "string" },
        "vcpu": { "type": "integer", "minimum": 1 },
        "ram_bytes": { "type": "integer", "minimum": 1 },
        "scratch_bytes": { "type": "integer", "minimum": 1 },
        "compiler": { "type": "string" },
        "cmake": { "type": "string" },
        "openssl": { "type": "string" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rtt_ms", "bandwidth_mbit_s", "netem_id"],
      "properties": {
        "mode": { "enum": ["loopback_diagnostic", "LAN", "WAN"] },
        "rtt_ms": { "type": ["number", "null"], "minimum": 0 },
        "bandwidth_mbit_s": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "netem_id": { "type": ["string", "null"] }
      }
    },
    "n": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "k": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "The run validator must additionally enforce k <= n." },
    "dataset_id": { "type": "string", "minLength": 1 },
    "input_sha256": { "$ref": "#/$defs/sha256" },
    "oracle_sha256": { "$ref": "#/$defs/sha256" },
    "input_seed_id": { "type": "string", "description": "Public deterministic input generator seed/identifier; never an algorithm randomness seed." },
    "share_split_seed_id": { "type": "string", "description": "TEST_ONLY input-share generation identifier, not a party-side secret." },
    "algorithm_randomness": {
      "enum": ["OS_CSPRNG_fresh_per_attempt", "NOT_USED_n1_shortcut"],
      "description": "The n=1 shortcut consumes no algorithm randomness; all other executions require a fresh OS CSPRNG stream."
    },
    "session_id": { "type": "string", "minLength": 1 },
    "terminal_status": { "enum": ["SUCCESS", "PEER_AGREED_ALGORITHM_ABORT", "LOCAL_ONLY_ALGORITHM_ABORT", "MATERIAL_ERROR", "COMMUNICATION_ERROR", "ENGINEERING_ERROR", "PRECHECK_REJECTED"] },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle_checked", "oracle_equal", "mask_length", "mask_binary", "mask_weight_k", "mask_published"],
      "properties": {
        "oracle_checked": { "type": "boolean" },
        "oracle_equal": { "type": ["boolean", "null"] },
        "mask_length": { "type": ["integer", "null"], "minimum": 0 },
        "mask_binary": { "type": ["boolean", "null"] },
        "mask_weight_k": { "type": ["boolean", "null"] },
        "mask_published": { "type": "boolean" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offline_time_ms", "offline_material_total_bits", "online_time_ms", "online_comm_total_bits", "online_comm_per_party_bits", "online_rounds", "online_prg_calls_total", "comparison_edges_total", "total_time_ms"],
      "properties": {
        "offline_time_ms": { "type": ["number", "null"], "minimum": 0 },
        "offline_material_total_bits": { "type": ["integer", "null"], "minimum": 0 },
        "online_time_ms": { "type": ["number", "null"], "minimum": 0 },
        "online_comm_total_bits": { "type": ["integer", "null"], "minimum": 0 },
        "online_comm_per_party_bits": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["p0_sent_bits", "p1_sent_bits"],
          "properties": {
            "p0_sent_bits": { "type": "integer", "minimum": 0 },
            "p1_sent_bits": { "type": "integer", "minimum": 0 }
          }
        },
        "online_rounds": { "type": ["integer", "null"], "minimum": 0 },
        "online_prg_calls_total": { "type": ["integer", "null"], "minimum": 0 },
        "comparison_edges_total": { "type": ["integer", "null"], "minimum": 0 },
        "total_time_ms": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "metric_provenance": {
      "type": "object",
      "additionalProperties": { "enum": ["MEASURED", "CHECKED_LAYOUT_DERIVATION", "NOT_MEASURED"] }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_score_ucmp_calls", "select_logical_calls_r1_r4", "select_repeated_requests", "select_dummy_requests", "membership_logical_calls", "unique_material_slots", "dcf_party_evaluations", "dcf_aes_expansion_calls", "aes_block_count", "sampler_sha256_counter_words", "prg_stream_calls", "p0_sent_bytes", "p0_received_bytes", "p1_sent_bytes", "p1_received_bytes", "p0_rss_peak_bytes", "p1_rss_peak_bytes", "t_rss_peak_bytes"],
      "properties": {
        "raw_score_ucmp_calls": { "type": ["integer", "null"], "minimum": 0 },
        "select_logical_calls_r1_r4": { "type": ["integer", "null"], "minimum": 0 },
        "select_repeated_requests": { "type": ["integer", "null"], "minimum": 0 },
        "select_dummy_requests": { "type": ["integer", "null"], "minimum": 0 },
        "membership_logical_calls": { "type": ["integer", "null"], "minimum": 0 },
        "unique_material_slots": { "type": ["integer", "null"], "minimum": 0 },
        "dcf_party_evaluations": { "type": ["integer", "null"], "minimum": 0 },
        "dcf_aes_expansion_calls": { "type": ["integer", "null"], "minimum": 0 },
        "aes_block_count": { "type": ["integer", "null"], "minimum": 0 },
        "sampler_sha256_counter_words": { "type": ["integer", "null"], "minimum": 0 },
        "prg_stream_calls": { "type": ["integer", "null"], "minimum": 0 },
        "p0_sent_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "p0_received_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "p1_sent_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "p1_received_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "p0_rss_peak_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "p1_rss_peak_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "t_rss_peak_bytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "raw_record_sha256": { "$ref": "#/$defs/sha256" },
    "raw_record_uri": { "type": "string" },
    "command": { "type": "string" },
    "failure_stage": { "type": ["string", "null"] },
    "attempt_number": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "sha40": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" }
  }
}
