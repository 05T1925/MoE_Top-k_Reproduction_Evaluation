{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moe-topk:BMW16_RUN_RECORD_SCHEMA:2.0",
  "title": "BMW16-derived Protocol I diagnostic run record",
  "description": "One attempt. PROJECT_DERIVED; diagnostic records are not formal V4 results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "attempt_type", "protocol_tag", "implementation_label",
    "source_commit", "binary_sha256", "build_options_sha256", "host", "network", "n", "k",
    "dataset_id", "input_sha256", "oracle_sha256", "oracle_implementation_sha256",
    "input_seed_id", "share_split_seed_id",
    "algorithm_randomness", "session_id", "terminal_status", "correctness", "metrics",
    "metric_units", "metric_provenance", "counts", "auxiliary", "raw_evidence_manifest",
    "raw_record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_type": {"const": "EXPERIMENTAL_DIAGNOSTIC"},
    "protocol_tag": {"const": "Protocol I + BMW16-derived Select + DCF / PROJECT_DERIVED"},
    "implementation_label": {"const": "conditional_secure_v2"},
    "source_commit": {"$ref": "#/$defs/hash40"},
    "binary_sha256": {"$ref": "#/$defs/hash256"},
    "build_options_sha256": {"$ref": "#/$defs/hash256"},
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "kernel", "cpu_model", "vcpu", "ram_bytes", "scratch_bytes", "compiler", "cmake", "openssl"],
      "properties": {
        "os": {"type": "string"}, "kernel": {"type": "string"}, "cpu_model": {"type": "string"},
        "vcpu": {"type": "integer", "minimum": 1}, "ram_bytes": {"type": "integer", "minimum": 1},
        "scratch_bytes": {"type": "integer", "minimum": 1}, "compiler": {"type": "string"},
        "cmake": {"type": "string"}, "openssl": {"type": "string"}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "rtt_ms", "bandwidth_mbit_s", "netem_id", "online_tls_wire_bytes"],
      "properties": {
        "mode": {"const": "loopback_diagnostic"}, "rtt_ms": {"type": ["number", "null"]},
        "bandwidth_mbit_s": {"type": ["number", "null"]}, "netem_id": {"type": ["string", "null"]},
        "online_tls_wire_bytes": {"type": "null"}
      }
    },
    "n": {"type": "integer", "minimum": 2, "maximum": 1000},
    "k": {"type": "integer", "minimum": 1, "maximum": 1000},
    "dataset_id": {"type": "string", "minLength": 1},
    "input_sha256": {"$ref": "#/$defs/hash256"},
    "oracle_sha256": {"$ref": "#/$defs/hash256"},
    "oracle_implementation_sha256": {"$ref": "#/$defs/hash256"},
    "input_seed_id": {"type": "string", "minLength": 1},
    "share_split_seed_id": {"type": "string", "minLength": 1},
    "algorithm_randomness": {"const": "OS_CSPRNG_fresh_per_attempt"},
    "session_id": {"type": "string", "minLength": 1},
    "terminal_status": {"enum": ["SUCCESS", "PEER_AGREED_ALGORITHM_ABORT", "MATERIAL_ERROR", "COMMUNICATION_ERROR", "ENGINEERING_ERROR", "PRECHECK_REJECTED"]},
    "correctness": {
      "type": "object", "additionalProperties": false,
      "required": ["oracle_checked", "oracle_equal", "mask_length", "mask_binary", "mask_weight_k", "mask_published"],
      "properties": {
        "oracle_checked": {"type": "boolean"}, "oracle_equal": {"type": ["boolean", "null"]},
        "mask_length": {"type": ["integer", "null"], "minimum": 0},
        "mask_binary": {"type": ["boolean", "null"]}, "mask_weight_k": {"type": ["boolean", "null"]},
        "mask_published": {"type": "boolean"}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["offline_time_ms", "offline_material_total_bits", "online_time_ms", "online_comm_total_bits", "online_comm_per_party_bits", "online_rounds", "online_prg_calls_total", "comparison_edges_total", "total_time_ms"],
      "properties": {
        "offline_time_ms": {"type": ["number", "null"], "minimum": 0},
        "offline_material_total_bits": {"type": ["integer", "null"], "minimum": 0},
        "online_time_ms": {"type": ["number", "null"], "minimum": 0},
        "online_comm_total_bits": {"type": ["integer", "null"], "minimum": 0},
        "online_comm_per_party_bits": {"type": ["integer", "null"], "minimum": 0},
        "online_rounds": {"type": ["integer", "null"], "minimum": 0},
        "online_prg_calls_total": {"type": ["integer", "null"], "minimum": 0},
        "comparison_edges_total": {"type": ["integer", "null"], "minimum": 0},
        "total_time_ms": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "metric_units": {"type": "object", "additionalProperties": {"type": "string"}},
    "metric_provenance": {"type": "object", "additionalProperties": {"enum": ["MEASURED", "CHECKED_CALLSITE_DERIVATION", "NOT_MEASURED"]}},
    "counts": {"type": "object", "additionalProperties": {"type": ["integer", "null"], "minimum": 0}},
    "auxiliary": {"type": "object"},
    "raw_evidence_manifest": {"type": "string", "minLength": 1},
    "raw_record_sha256": {"$ref": "#/$defs/hash256"}
  },
  "$defs": {
    "hash40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hash256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
