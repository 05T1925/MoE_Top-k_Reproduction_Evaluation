{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://05T1925.github.io/MoE_Top-k_Reproduction_Evaluation/protocol-i-unified-run-record-v3.json",
  "title": "Protocol I unified nine-metric attempt and campaign record",
  "description": "One record per route attempt, plus a campaign envelope. Values unavailable at the selected layer are null and carry NOT_MEASURED provenance.",
  "oneOf": [
    { "$ref": "#/$defs/attempt" },
    { "$ref": "#/$defs/campaign" }
  ],
  "$defs": {
    "nullableNumber": { "type": ["number", "null"], "minimum": 0 },
    "hashOrNull": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "attempt": {
      "type": "object",
      "required": ["schema_version", "record_type", "campaign_id", "attempt_id", "attempt_type", "run_index", "route", "implementation_label", "security_profile", "source", "input", "host", "network", "terminal_status", "failure_reason", "correctness", "metrics", "metric_units", "metric_provenance", "counts", "auxiliary", "evidence"],
      "properties": {
        "schema_version": { "const": "3.0" },
        "record_type": { "const": "attempt" },
        "campaign_id": { "type": "string", "minLength": 1 },
        "attempt_id": { "type": "string", "minLength": 1 },
        "attempt_type": { "enum": ["DIAGNOSTIC", "WARMUP", "FORMAL"] },
        "run_index": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "route": { "enum": ["protocol_i_all_pairs", "protocol_i_aav86", "protocol_i_bmw16_derived_select_dcf"] },
        "implementation_label": { "type": "string", "minLength": 1 },
        "security_profile": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["base_commit", "working_tree_diff_sha256", "binary_sha256", "build_options_sha256"],
          "properties": {
            "base_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
            "working_tree_diff_sha256": { "$ref": "#/$defs/hashOrNull" },
            "binary_sha256": { "$ref": "#/$defs/hashOrNull" },
            "build_options_sha256": { "$ref": "#/$defs/hashOrNull" }
          }, "additionalProperties": false
        },
        "input": {
          "type": "object",
          "required": ["n", "k", "score_encoding", "generator", "seed_id", "input_sha256", "oracle_sha256", "oracle_fnv64", "shared_oracle_fnv64", "oracle_implementation_sha256"],
          "properties": {
            "n": { "type": "integer", "minimum": 2 }, "k": { "type": "integer", "minimum": 1 },
            "score_encoding": { "const": "signed_Q20.12" },
            "generator": { "type": "string" }, "seed_id": { "type": "string" },
            "input_sha256": { "$ref": "#/$defs/hashOrNull" }, "input_fnv64": { "type": ["string", "null"] },
            "oracle_sha256": { "$ref": "#/$defs/hashOrNull" },
            "oracle_fnv64": { "type": ["string", "null"] }, "shared_oracle_fnv64": { "type": ["string", "null"] },
            "oracle_implementation_sha256": { "$ref": "#/$defs/hashOrNull" }
          }, "additionalProperties": false
        },
        "host": { "type": "object", "required": ["os", "kernel", "cpu_model", "vcpu", "ram_bytes", "scratch_bytes", "compiler", "cmake", "openssl"] },
        "network": {
          "type": "object",
          "required": ["mode", "rtt_ms", "throughput_mbit_s", "topology_id", "netem_id", "measurement_method", "online_tls_wire_bytes", "offline_tls_delivery_bytes"],
          "properties": {
            "mode": { "enum": ["loopback_diagnostic", "LAN", "WAN", "NOT_MEASURED"] },
            "rtt_ms": { "$ref": "#/$defs/nullableNumber" },
            "throughput_mbit_s": { "$ref": "#/$defs/nullableNumber" },
            "topology_id": { "type": ["string", "null"] }, "netem_id": { "type": ["string", "null"] },
            "measurement_method": { "type": ["string", "null"] },
            "online_tls_wire_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "offline_tls_delivery_bytes": { "type": ["integer", "null"], "minimum": 0 }
          }, "additionalProperties": true
        },
        "terminal_status": { "enum": ["SUCCESS", "PEER_AGREED_ALGORITHM_ABORT", "MATERIAL_ERROR", "COMMUNICATION_ERROR", "ENGINEERING_ERROR", "PRECHECK_REJECTED", "TIMEOUT"] },
        "failure_reason": { "type": ["string", "null"] },
        "correctness": {
          "type": "object", "required": ["oracle_checked", "oracle_equal", "mask_length", "mask_binary", "mask_weight_k", "mask_published"],
          "properties": {
            "oracle_checked": { "type": "boolean" }, "oracle_equal": { "type": ["boolean", "null"] },
            "mask_length": { "type": ["integer", "null"] }, "mask_binary": { "type": ["boolean", "null"] },
            "mask_weight_k": { "type": ["boolean", "null"] }, "mask_published": { "type": "boolean" }
          }, "additionalProperties": false
        },
        "metrics": {
          "type": "object", "required": ["offline_time_ms", "offline_material_total_bits", "online_time_ms", "online_comm_total_bits", "online_comm_per_party_bits", "online_rounds", "online_prg_calls_total", "comparison_edges_total", "total_time_ms"],
          "properties": {
            "offline_time_ms": { "$ref": "#/$defs/nullableNumber" },
            "offline_material_total_bits": { "$ref": "#/$defs/nullableNumber" },
            "online_time_ms": { "$ref": "#/$defs/nullableNumber" },
            "online_comm_total_bits": { "$ref": "#/$defs/nullableNumber" },
            "online_comm_per_party_bits": { "$ref": "#/$defs/nullableNumber" },
            "online_rounds": { "type": ["integer", "null"], "minimum": 0 },
            "online_prg_calls_total": { "type": ["integer", "null"], "minimum": 0 },
            "comparison_edges_total": { "type": ["integer", "null"], "minimum": 0 },
            "total_time_ms": { "$ref": "#/$defs/nullableNumber" }
          }, "additionalProperties": false
        },
        "metric_units": { "type": "object", "required": ["offline_time_ms", "offline_material_total_bits", "online_time_ms", "online_comm_total_bits", "online_comm_per_party_bits", "online_rounds", "online_prg_calls_total", "comparison_edges_total", "total_time_ms"], "additionalProperties": { "type": "string" } },
        "metric_provenance": { "type": "object", "additionalProperties": { "enum": ["MEASURED", "CHECKED_CALLSITE_DERIVATION", "NOT_MEASURED"] } },
        "counts": { "type": "object" },
        "auxiliary": { "type": "object" },
        "evidence": {
          "type": "object", "required": ["directory", "manifest_sha256", "files"],
          "properties": {
            "directory": { "type": "string" }, "manifest_sha256": { "$ref": "#/$defs/hashOrNull" },
            "files": { "type": "array", "items": { "type": "object", "required": ["path", "sha256", "bytes"], "properties": { "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/hashOrNull" }, "bytes": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }
          }, "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "attempt_type": { "enum": ["WARMUP", "FORMAL"] } }, "required": ["attempt_type"] },
          "then": {
            "properties": {
              "network": {
                "properties": {
                  "mode": { "enum": ["LAN", "WAN"] },
                  "rtt_ms": { "type": "number", "minimum": 0 },
                  "throughput_mbit_s": { "type": "number", "exclusiveMinimum": 0 },
                  "topology_id": { "type": "string", "minLength": 1 },
                  "measurement_method": { "type": "string", "minLength": 1 }
                },
                "required": ["mode", "rtt_ms", "throughput_mbit_s", "topology_id", "measurement_method"]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "campaign": {
      "type": "object",
      "required": ["schema_version", "record_type", "campaign_id", "campaign_type", "phase_gate", "route_set", "configuration", "network", "warmups_per_route", "formal_repetitions_per_route", "attempts", "campaign_status", "campaign_outcome"],
      "properties": {
        "schema_version": { "const": "3.0" }, "record_type": { "const": "campaign" },
        "campaign_id": { "type": "string" }, "campaign_type": { "enum": ["DIAGNOSTIC", "FORMAL"] },
        "phase_gate": { "enum": ["V3_OPEN", "V3_CLOSED"] },
        "route_set": { "type": "array", "items": { "enum": ["protocol_i_all_pairs", "protocol_i_aav86", "protocol_i_bmw16_derived_select_dcf"] }, "minItems": 1, "uniqueItems": true },
        "configuration": { "type": "object", "required": ["n", "k", "input_seed_id", "input_sha256", "oracle_sha256", "oracle_fnv64"] },
        "network": { "type": "object", "required": ["mode", "rtt_ms", "throughput_mbit_s", "topology_id"] },
        "warmups_per_route": { "type": "integer", "minimum": 0 },
        "formal_repetitions_per_route": { "const": 5 },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/attemptRef" } },
        "campaign_status": { "enum": ["READY", "RUNNING", "COMPLETE", "PRECHECK_REJECTED", "NOT_RUN"] },
        "campaign_outcome": { "enum": ["ALL_SUCCEEDED", "ATTEMPT_FAILURES_RETAINED", "NOT_RUN"] }
      },
      "allOf": [
        { "if": { "properties": { "campaign_type": { "const": "FORMAL" } }, "required": ["campaign_type"] },
          "then": { "properties": { "phase_gate": { "const": "V3_CLOSED" }, "route_set": { "minItems": 3, "maxItems": 3 }, "network": { "properties": { "mode": { "enum": ["LAN", "WAN"] }, "rtt_ms": { "type": "number" }, "throughput_mbit_s": { "type": "number" }, "topology_id": { "type": "string" } }, "required": ["mode", "rtt_ms", "throughput_mbit_s", "topology_id"] }, "warmups_per_route": { "const": 1 }, "attempts": { "minItems": 18 } } } }
      ], "additionalProperties": false
    },
    "attemptRef": {
      "type": "object",
      "required": ["route", "attempt_id", "attempt_type", "run_index", "record_path", "record_sha256", "terminal_status"],
      "properties": {
        "route": { "enum": ["protocol_i_all_pairs", "protocol_i_aav86", "protocol_i_bmw16_derived_select_dcf"] },
        "attempt_id": { "type": "string" }, "attempt_type": { "enum": ["DIAGNOSTIC", "WARMUP", "FORMAL"] },
        "run_index": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "record_path": { "type": "string" }, "record_sha256": { "$ref": "#/$defs/hashOrNull" },
        "terminal_status": { "enum": ["SUCCESS", "PEER_AGREED_ALGORITHM_ABORT", "MATERIAL_ERROR", "COMMUNICATION_ERROR", "ENGINEERING_ERROR", "PRECHECK_REJECTED", "TIMEOUT"] }
      }, "additionalProperties": false
    }
  }
}
